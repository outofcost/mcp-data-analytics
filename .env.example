# Скопируйте этот файл в .env и заполните. Серверу эти переменные не нужны,
# их читают клиенты из папки clients/.

# Ключ OpenRouter (https://openrouter.ai/keys). Обязателен для клиентов.
OPENROUTER_API_KEY=
# Модель с поддержкой инструментов. Пусто: берётся модель по умолчанию.
OPENROUTER_MODEL=
# Токен бота от @BotFather. Нужен только для clients/telegram_bot.py.
TELEGRAM_BOT_TOKEN=
# Номера чатов через запятую, которым бот отвечает. Пусто: отвечает всем.
TELEGRAM_ALLOWED_CHATS=
